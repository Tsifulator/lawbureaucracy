# Copy to .env only if you want to change defaults. Retrieval is always local.
#
# Answer engine: 'ollama' (default) runs local Llama-Krikri — free, no key.
#   ANSWER_ENGINE=ollama
#   ANSWER_MODEL=krikri
#
# To use cloud Gemini instead (needs a key from aistudio.google.com/apikey):
#   ANSWER_ENGINE=gemini
#   GEMINI_API_KEY=your_key_here
#   GEMINI_MODEL=gemini-flash-latest   # optional; auto-tracks newest Flash
#
# Or ANY OpenAI-compatible provider — Groq, OpenRouter, Together, DeepSeek,
# Cerebras… Only these change between providers; no code does:
#   ANSWER_ENGINE=openai_compat
#   LLM_API_KEY=your_key_here
#   LLM_BASE=https://api.groq.com/openai/v1        # default (Groq free tier)
#   LLM_MODEL=llama-3.3-70b-versatile              # default
#   LLM_LABEL=Llama 3.3                            # name shown in the UI
# Examples:
#   OpenRouter  LLM_BASE=https://openrouter.ai/api/v1
#   Together    LLM_BASE=https://api.together.xyz/v1
#   DeepSeek    LLM_BASE=https://api.deepseek.com/v1
#   local test  LLM_BASE=http://localhost:11434/v1  LLM_MODEL=krikri
#
# REWRITE=1   # set 0 to skip LLM query-sharpening before search
#
# Chat history. Default (unset) = every browser gets its OWN history, which is
# what a shared/hosted URL needs. On a single-user machine set this to keep one
# shared sidebar for yourself:
#   SHARED_HISTORY=1
