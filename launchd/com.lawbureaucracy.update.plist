<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily incremental refresh at 07:30: pull new decisions, embed them, reload
     the running server. Install same way as the brain plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lawbureaucracy.update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/.venv/bin/python</string>
        <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/update.py</string>
        <string>--new-only</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/data/update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/data/update.err</string>
</dict>
</plist>
