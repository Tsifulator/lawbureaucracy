<?xml version="1.0" encoding="UTF-8"?>
<!-- Keeps the search server running so Raycast can always reach it.
     Install:  cp this file to ~/Library/LaunchAgents/ then
               launchctl load ~/Library/LaunchAgents/com.lawbureaucracy.brain.plist
     Edit the two paths below if your username/venv differ. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lawbureaucracy.brain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/.venv/bin/python</string>
        <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/data/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicholastsiflikiotis/Code/lawbureaucracy/brain/data/server.err</string>
</dict>
</plist>
